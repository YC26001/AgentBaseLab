# Optional Compose settings. Defaults work without a .env file.
OLLAMA_MODEL=gemma4:12b
OLLAMA_IMAGE=ollama/ollama:latest

# Browser-visible hostname or IP, without scheme or port.
APP_HOST=localhost
WEB_PORT=3000
CORE_PORT=3001
# Use 0.0.0.0 to accept connections from other machines.
BIND_ADDRESS=127.0.0.1
